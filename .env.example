# Copy to .env or set in Zeabur Variables. Never commit real keys.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Optional. If empty, the first person who presses Start becomes owner.
TELEGRAM_OWNER_ID=
# Alias for TELEGRAM_OWNER_ID (same numeric chat/user id).
TELEGRAM_CHAT_ID=

# --- Dashboard ---
# Required in production. Random token if empty (printed at boot).
DASHBOARD_TOKEN=
PORT=8080

# --- Engine ---
# paper | live  — live still needs keys AND a Telegram two-step confirm
TRADING_MODE=paper
DATA_DIR=./data
ENGINE_AUTOSTART=true

# --- Polymarket (only needed for live) ---
POLYMARKET_PRIVATE_KEY=
# Optional L2 creds; SDK can derive them from the private key
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# --- Safety ---
# If true, refuse live even after Telegram confirm
FORCE_PAPER=false
